# ============================================
# CNPC Promotion Retail - Environment Variables
# ============================================
# Copy this file to .env and modify values as needed.
# NEVER commit the .env file to version control.
# For production, use strong passwords and secrets.

# ===== Backend =====
DB_URL=jdbc:postgresql://localhost:5432/cnpc_promotion
DB_USERNAME=cnpc
DB_PASSWORD=cnpc
SERVER_PORT=18082

# ===== Frontend =====
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT=10000

# ===== Docker Compose (PostgreSQL) =====
POSTGRES_DB=cnpc_promotion
POSTGRES_USER=cnpc
POSTGRES_PASSWORD=cnpc
POSTGRES_PORT=5432
